# Скопируйте в `.env` и заполните локально. Файл `.env` не коммитится.

# Travelpayouts / Aviasales Data API (токен из кабинета партнёра)
TRAVELPAYOUTS_TOKEN=

# Telegram Bot API
BOT_TOKEN=

# LLM provider API key (для этапа рекомендаций)
LLM_API_KEY=
# Парсинг брифа: rules | role_llm (рекомендуется)
PARSER_MODE=role_llm
LLM_BRIEF_STRUCTURED_MODEL=gpt-4o-mini
# Алиас (если PARSER_MODE не задан): USE_STRUCTURED_BRIEF_PIPELINE=true
USE_STRUCTURED_BRIEF_PIPELINE=false
# Fallback для live/intent, если не задан LLM_BRIEF_STRUCTURED_MODEL:
LLM_PARSER_MODEL=gpt-4o-mini
# true | TRUE | yes | 1 — все включают живые ответы; нужен LLM_API_KEY
USE_LLM_LIVE_RESPONSES=false
LLM_LIVE_MODEL=gpt-4o-mini

# Логи в Telegram-группу (parse quality + session summary)
LOG_GROUP_ENABLED=false
LOG_GROUP_CHAT_ID=
LOG_SESSION_IDLE_SEC=300
